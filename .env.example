# Postgres (matches docker-compose.yml). Two users:
# - MIGRATION_DATABASE_URL: the database owner; only `npm run db:migrate` and drizzle-kit use it.
# - DATABASE_URL: the app's own login. `npm run db:migrate` creates this user with this password;
#   it can only read data through row-level security (drizzle/0026_runtime_roles.sql).
#   Pick any password, e.g. `openssl rand -hex 24`.
MIGRATION_DATABASE_URL=postgres://myuser:mypassword@localhost:5433/haushaltsbuch
DATABASE_URL=postgres://haushaltsbuch_app:change-me@localhost:5433/haushaltsbuch

# Better Auth (sessions): generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public address of the app; invite links are built from it
BETTER_AUTH_URL=http://localhost:3000

# How people sign in: identity (zero-trust provider, the default when unset) or dev (local only).
# dev works only with `next dev` and BETTER_AUTH_URL on localhost; the app refuses to start otherwise.
AUTH_MODE=dev
# identity mode: the provider that signs the login token (Cloudflare Access, docs/deployment.md)
IDENTITY_ISSUER=
IDENTITY_JWKS_URL=
# Cloudflare: the Access application's AUD tag
IDENTITY_AUDIENCE=
# Optional: header with the token (default Cf-Access-Jwt-Assertion) and where sign-out leads
# (default /cdn-cgi/access/logout, which ends the Cloudflare Access login)
IDENTITY_JWT_HEADER=
IDENTITY_LOGOUT_URL=
# identity mode, required: who may use the app (comma-separated). A second lock behind the
# Cloudflare Access policy; production takes it from the GitHub variable ALLOWED_EMAILS.
ALLOWED_EMAILS=

# Field encryption (IBANs, later names and references). Never stored in the database.
# Comma-separated <version>:<base64 32-byte key>; the highest version encrypts new values, all
# listed versions decrypt. To rotate, append a new version and keep the old ones.
# Generate a key with `openssl rand -base64 32`.
FIELD_ENCRYPTION_KEYS=1:
# Key for blind indexes (search encrypted IBANs, import fingerprints): `openssl rand -base64 32`.
# Changing it requires recomputing every stored index.
BLIND_INDEX_KEY=
