# Copy to .env.local and adjust.
DATABASE_URL=postgres://haushaltsbuch:haushaltsbuch@localhost:5432/haushaltsbuch

# Public URL of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# open | invite-only | closed (the first user can always register)
AUTH_SIGN_UP_MODE=invite-only
# Domain for passkeys, e.g. haushalt.example (defaults to localhost)
AUTH_PASSKEY_RP_ID=
